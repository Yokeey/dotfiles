{
    "files.autoSave": "afterDelay",
    "editor.fontSize": 15,
    "terminal.integrated.customGlyphs": false,
    "latex-workshop.view.pdf.invert": 0.9,
    "editor.minimap.enabled": false,
    "ltex.additionalRules.enablePickyRules": true,
    "ltex.additionalRules.motherTongue": "en-AU",
    "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
    "workbench.iconTheme": "material-icon-theme",
    "[latex]": {
        "editor.wordWrap": "on"
    },
    "terminal.integrated.fontSize": 15,
    "editor.lineNumbers": "relative",
    "extensions.ignoreRecommendations": true,
    "workbench.activityBar.compact": true,
    "workbench.activityBar.location": "hidden",
    "chat.titleBar.signIn.enabled": false,
    "workbench.navigationControl.enabled": false,
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "workbench.editor.enablePreview": false,
    "chat.disableAIFeatures": true,
    "breadcrumbs.enabled": false,
    "workbench.colorCustomizations": {
        "[Dark Modern]": {}
    },
    "workbench.colorTheme": "Tokyo Night",
    "workbench.preferredDarkColorTheme": "Monokai",
    "workbench.tips.enabled": false,
    "workbench.tree.enableStickyScroll": false,
    "workbench.settings.alwaysShowAdvancedSettings": true,
    "workbench.settings.showAISearchToggle": false,
    "window.customTitleBarVisibility": "never",
    "window.titleBarStyle": "native",
    "window.density.editorTabHeight": "compact",
    "window.nativeFullScreen": false,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "workbench.editor.titleScrollbarVisibility": "hidden",
    "editor.stickyScroll.scrollWithEditor": false,
    "scm.diffDecorations": "none",
    "editor.hideCursorInOverviewRuler": true,
    "editor.overviewRulerBorder": false,
    "workbench.colorCustomizations": {
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.errorForeground": "#00000000",
    "editorOverviewRuler.warningForeground": "#00000000",
    "editorOverviewRuler.infoForeground": "#00000000",
    "editorOverviewRuler.findMatchForeground": "#00000000",
    "editorOverviewRuler.selectionHighlightForeground": "#00000000",
    "editorOverviewRuler.wordHighlightForeground": "#00000000",
    "editorOverviewRuler.modifiedForeground": "#00000000",
    "editorOverviewRuler.addedForeground": "#00000000",
    "editorOverviewRuler.deletedForeground": "#00000000"
},
"window.restoreFullscreen": true,
"window.newWindowDimensions": "fullscreen",
"chat.agent.enabled": false,
"explorer.autoOpenDroppedFile": false,
"explorer.autoReveal": false,
"terminal.external.osxExec": "Ghostty.app",
"terminal.external.linuxExec": "Ghostty",
"terminal.integrated.cursorBlinking": true,
"terminal.integrated.copyOnSelection": true,
"terminal.integrated.defaultProfile.osx": "zsh",
"terminal.integrated.fontLigatures.enabled": true,
"terminal.integrated.macOptionIsMeta": true,
"terminal.integrated.stickyScroll.enabled": false,
"terminal.integrated.suggest.enabled": false,
"terminal.integrated.tabs.allowAgentCliTitle": false,
"terminal.integrated.tabs.enabled": false,
"terminal.integrated.suggest.providers": {
    "vscode.terminal-suggest": false
},
"output.smartScroll.enabled": false,
"security.workspace.trust.startupPrompt": "once",
"editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
"terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
"editor.fontLigatures": true,
"editor.stickyScroll.enabled": false,
"editor.autoClosingBrackets": "never",
"editor.guides.bracketPairsHorizontal": false,
"editor.guides.highlightActiveBracketPair": false,
"editor.matchBrackets": "never",
"editor.autoClosingDelete": "never",
"editor.autoSurround": "never",
"terminal.integrated.shellIntegration.decorationsEnabled": "never",
"editor.quickSuggestions": { "other": "off", "comments": "off", "strings": "off" },
"editor.suggestOnTriggerCharacters": false,
"editor.wordBasedSuggestions": "off",
"editor.inlineSuggest.enabled": false,
"editor.acceptSuggestionOnEnter": "off",
"editor.acceptSuggestionOnCommitCharacter": false,
"editor.snippetSuggestions": "none",

"editor.parameterHints.enabled": false,
"editor.hover.enabled": "onKeyboardModifier",
"editor.lightbulb.enabled": "off",
"editor.codeLens": false,
"editor.inlayHints.enabled": "offUnlessPressed",
"editor.colorDecorators.enabled": false,

"editor.formatOnType": false,
"editor.formatOnPaste": false,
"editor.linkedEditing": false,
"editor.autoIndent": "keep",
"editor.autoClosingOvertype": "never",
"rust-analyzer.lens.enable": false,
  "editor.formatOnSave": false,
  "[julia]": { "editor.formatOnSave": true, "editor.defaultFormatter": "julialang.language-julia" },
  "[rust]":  { "editor.formatOnSave": true, "editor.defaultFormatter": "rust-lang.rust-analyzer" },
  "[typst]": { "editor.formatOnSave": true, "editor.defaultFormatter": "myriad-dreamin.tinymist" },
  "rust-analyzer.check.command": "clippy",
"tinymist.formatterMode": "typstyle",
"terminal.integrated.commandsToSkipShell": [
    "language-julia.interrupt"
],
"julia.symbolCacheDownload": true,
"tinymist.lint.enabled": true,
"workbench.startupEditor": "newUntitledFile",
"julia.enableTelemetry": true,
"extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
},
"vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
"zenMode.hideStatusBar": false,
"vscode-neovim.neovimClean": true,
"workbench.editor.showTabs": "none",
"workbench.panel.showLabels": false,
"workbench.panel.defaultLocation": "right",
}